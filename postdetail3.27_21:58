<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title th:text="${post.title} + ' - 辉吧'">帖子详情</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', monospace; background: #0a0f1f; color: #e0e0ff; line-height: 1.6; }
        .navbar { background: rgba(5,10,25,0.95); backdrop-filter: blur(10px); border-bottom: 1px solid #00aaff33; position: sticky; top: 0; z-index: 1000; }
        .nav-container { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 2rem; }
        .logo a { font-size: 1.8rem; font-weight: bold; text-decoration: none; background: linear-gradient(135deg, #00aaff, #0066cc); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .nav-links { display: flex; gap: 1.5rem; }
        .nav-links a { color: #b0c4ff; text-decoration: none; font-weight: 500; transition: 0.3s; }
        .nav-links a:hover { color: #00aaff; text-shadow: 0 0 5px #00aaff; }
        .search-form { flex: 1; max-width: 300px; margin: 0 1rem; }
        .search-box { display: flex; }
        .search-box input { width: 100%; padding: 0.5rem 1rem; background: #1a1f2f; border: 1px solid #2a3f5f; border-radius: 30px 0 0 30px; color: #fff; outline: none; }
        .search-box button { padding: 0.5rem 1rem; background: #00aaff; border: none; border-radius: 0 30px 30px 0; color: #0a0f1f; cursor: pointer; font-weight: bold; }
        .user-area { display: flex; align-items: center; gap: 1rem; }
        .user-info { display: flex; align-items: center; gap: 0.5rem; }
        .avatar { width: 32px; height: 32px; background: linear-gradient(135deg, #00aaff, #0066cc); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: white; }
        .username { font-weight: 500; }
        .logout-btn, .login-link, .register-link { text-decoration: none; padding: 0.4rem 1rem; border-radius: 20px; transition: 0.3s; }
        .logout-btn { background: #ff3366; color: white; }
        .login-link { color: #00aaff; border: 1px solid #00aaff; }
        .register-link { background: #00aaff; color: #0a0f1f; }
        .container { max-width: 800px; margin: 2rem auto; padding: 0 2rem; }
        .card { background: rgba(20,30,50,0.8); backdrop-filter: blur(8px); border-radius: 16px; border: 1px solid #2a3f5f; padding: 1.5rem; margin-bottom: 1.5rem; }
        .post-title { font-size: 2rem; color: #00aaff; margin-bottom: 1rem; }
        .post-meta { color: #88aaff; font-size: 0.9rem; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #2a3f5f; }
        .post-content { background: #0f1422; padding: 1.5rem; border-radius: 12px; line-height: 1.8; white-space: pre-wrap; margin: 1rem 0; }
        .comment-item { background: rgba(20,30,50,0.5); border-radius: 12px; padding: 1rem; margin-bottom: 1rem; }
        .comment-author { color: #88aaff; margin-bottom: 0.5rem; font-size: 0.85rem; }
        button { background: #00aaff; border: none; color: #0a0f1f; padding: 0.6rem 1.2rem; border-radius: 30px; cursor: pointer; font-weight: bold; transition: 0.3s; }
        button:hover { background: #0088cc; box-shadow: 0 0 10px #00aaff; }
        textarea { background: #1a1f2f; border: 1px solid #2a3f5f; padding: 0.6rem 1rem; border-radius: 8px; color: #fff; width: 100%; margin-bottom: 1rem; resize: vertical; }
        textarea:focus { outline: none; border-color: #00aaff; }
        .reply-form { margin-top: 2rem; }
        .error { color: #ff6666; background: #ff000020; padding: 0.5rem; border-radius: 8px; margin-bottom: 1rem; }
        .success { color: #66ff66; background: #00ff0020; padding: 0.5rem; border-radius: 8px; margin-bottom: 1rem; }
        .login-prompt { text-align: center; padding: 1rem; background: rgba(20,30,50,0.5); border-radius: 12px; }
        .login-prompt a { color: #00aaff; text-decoration: none; }
        .like-btn { margin-top: 1rem; }
    </style>
</head>
<body>
<nav class="navbar">
    <div class="nav-container">
        <div class="logo"><a th:href="@{/FirstPage}">辉吧</a></div>
        <div class="nav-links">
            <a th:href="@{/FirstPage}">首页</a>
            <a th:href="@{/category}">创建栏目</a>
            <a th:href="@{/post}">发帖</a>
        </div>
        <div class="search-form">
            <form th:action="@{/search}" method="get" class="search-box">
                <input type="text" name="keyword" placeholder="搜索帖子...">
                <button type="submit">🔍</button>
            </form>
        </div>
        <div class="user-area" th:if="${session.loginUser != null}">
            <div class="user-info">
                <span class="avatar" th:text="${#strings.substring(session.loginUser.username, 0, 1)}">U</span>
                <span class="username" th:text="${session.loginUser.username}">用户</span>
            </div>
            <a th:href="@{/logout}" class="logout-btn">退出</a>
        </div>
        <div class="user-area" th:unless="${session.loginUser != null}">
            <a th:href="@{/login}" class="login-link">登录</a>
            <a th:href="@{/register}" class="register-link">注册</a>
        </div>
    </div>
</nav>

<div class="container">
    <!-- 帖子主体 -->
    <div class="card">
        <h1 class="post-title" th:text="${post.title}">帖子标题</h1>
        <div class="post-meta">
            作者：<a th:href="@{'/user/' + ${post.user.id}}" th:text="${post.user.username}" style="color:#00aaff;">作者</a> |
            发布于：<span th:text="${#temporals.format(post.createdAt, 'yyyy-MM-dd HH:mm')}">时间</span> |
            浏览：<span th:text="${post.viewCount}">0</span> |
            点赞：<span th:text="${post.likeCount}">0</span> |
            评论：<span th:text="${post.commentCount}">0</span>
        </div>
        <div class="post-content" th:text="${post.content}">帖子内容</div>
        <button class="like-btn" th:data-id="${post.id}">👍 点赞 <span th:text="${post.likeCount}">0</span></button>
    </div>

    <!-- 评论区域 -->
    <div class="card">
        <h3>评论 (<span th:text="${#lists.size(comments)}">0</span>)</h3>

        <!-- 评论列表 -->
        <div th:if="${comments != null and !comments.isEmpty()}">
            <div th:each="comment : ${comments}" class="comment-item">
                <div class="comment-author">
                    <span style="color:#00aaff;" th:text="${comment.user.username}">用户</span>
                    <span th:text="${#temporals.format(comment.created, 'yyyy-MM-dd HH:mm')}">时间</span>
                </div>
                <div class="comment-content" th:text="${comment.content}">评论内容</div>
            </div>
        </div>
        <div th:if="${comments == null or comments.isEmpty()}">
            <p style="color:#88aaff; text-align:center;">暂无评论，快来抢沙发！</p>
        </div>

        <!-- 发表评论表单 -->
        <div th:if="${session.loginUser != null}" class="reply-form">
            <h4>发表评论</h4>
            <form th:action="@{'/post/' + ${post.id} + '/comment'}" method="post">
                <textarea name="content" rows="3" required placeholder="写下你的评论..."></textarea>
                <button type="submit">发表评论</button>
            </form>
        </div>
        <div th:unless="${session.loginUser != null}" class="login-prompt">
            <a th:href="@{/login}">登录</a> 后可以发表评论
        </div>
        <div th:if="${error}" class="error" th:text="${error}"></div>
        <div th:if="${success}" class="success" th:text="${success}"></div>
    </div>
</div>

<script>
    // 点赞功能
    document.querySelectorAll('.like-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            fetch(`/post/${id}/like`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const span = btn.querySelector('span');
                        if (span) span.innerText = data.likeCount;
                        btn.style.transform = 'scale(1.1)';
                        setTimeout(() => btn.style.transform = '', 200);
                    } else {
                        alert(data.message || '点赞失败');
                    }
                })
                .catch(err => console.error('点赞错误:', err));
        });
    });
</script>
</body>
</html>
